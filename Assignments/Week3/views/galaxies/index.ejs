<%- include("../partials/header") %>

<h1>Galaxies</h1>

<a href="/galaxies/new">Create Galaxy</a>

<ul>
<% galaxies.forEach(galaxy => { %>
    <li>
        <% if (galaxy.image) { %>
    <img 
    class="resource-thumbnail"
        src="/uploads/<%= galaxy.image %>"
        width="100"
    >
<% } %>

<a href="/galaxies/<%= galaxy.id %>">
    <%= galaxy.name %>
</a>
        |
        
        <a href="/galaxies/<%= galaxy.id %>/edit">
            Edit
        </a>

        |

        <form 
            action="/galaxies/<%= galaxy.id %>?_method=DELETE" 
                method="POST"
                style="display:inline"
                onsubmit="return confirm('Delete this galaxy?');">

    <button type="submit">Delete</button>

</form>
    </li>
<% }) %>
</ul>

<%- include("../partials/footer") %>